{
  "name": "agents-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "node --experimental-strip-types scripts/preview.ts",
    "preview:check": "node --experimental-strip-types scripts/check-preview.ts",
    "pdf": "node --experimental-strip-types scripts/pdf.ts",
    "typecheck": "tsc -b --pretty false",
    "source": "node --experimental-strip-types scripts/source.ts",
    "document:check": "node --experimental-strip-types scripts/check-document.ts",
    "model:check": "node --experimental-strip-types scripts/model-check.ts",
    "draft": "node --experimental-strip-types scripts/draft.ts",
    "draft:check": "node --experimental-strip-types scripts/check-draft.ts",
    "approve": "node --experimental-strip-types scripts/approve.ts",
    "approval:check": "node --experimental-strip-types scripts/check-approval.ts",
    "agent": "node --experimental-strip-types scripts/agent.ts",
    "agent:check": "node --experimental-strip-types scripts/check-agent.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "1.64.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  }
}
