{
  "name": "agents-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "node --experimental-strip-types scripts/preview.ts",
    "preview:check": "node --experimental-strip-types scripts/check-preview.ts",
    "pdf": "node --experimental-strip-types scripts/pdf.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "e2e": "node --experimental-strip-types tests/e2e-editor.ts",
    "source": "node --experimental-strip-types scripts/source.ts",
    "document:check": "node --experimental-strip-types scripts/check-document.ts",
    "model:check": "node --experimental-strip-types scripts/model-check.ts",
    "draft": "node --experimental-strip-types scripts/draft.ts",
    "draft:check": "node --experimental-strip-types scripts/check-draft.ts",
    "approve": "node --experimental-strip-types scripts/approve.ts",
    "approval:check": "node --experimental-strip-types scripts/check-approval.ts",
    "agent": "node --experimental-strip-types scripts/agent.ts",
    "agent:resume": "node --experimental-strip-types scripts/agent-resume.ts",
    "agent:check": "node --experimental-strip-types scripts/check-agent.ts",
    "tool:check": "node --experimental-strip-types scripts/tool-check.ts",
    "tool:check:local": "node --experimental-strip-types scripts/check-tool.ts",
    "tools:check": "node --experimental-strip-types scripts/check-tools.ts",
    "terms:check": "node --experimental-strip-types scripts/check-terms.ts",
    "agent:loop:check": "node --experimental-strip-types scripts/check-agent-loop.ts",
    "agent:resume:check": "node --experimental-strip-types scripts/check-agent-resume.ts",
    "report:check": "node --experimental-strip-types scripts/check-report.ts",
    "agent:journal:check": "node --experimental-strip-types scripts/check-agent-journal.ts",
    "boundaries:check": "node --experimental-strip-types scripts/check-boundaries.ts",
    "budget:check": "node --experimental-strip-types scripts/budget-status.ts",
    "check": "npm run typecheck && npm run document:check && npm run preview:check && npm run boundaries:check && npm run draft:check && npm run approval:check && npm run budget:check && npm run agent:check && npm run terms:check && npm run report:check && npm run tools:check && npm run test"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "1.64.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  }
}
